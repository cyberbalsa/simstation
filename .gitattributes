* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# The repository is designed for Git LFS. The current checkout can still run
# without LFS as long as the compiled fixture assets are present.
*.dmi filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.xcf filter=lfs diff=lfs merge=lfs -text
*.pdn filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.flac filter=lfs diff=lfs merge=lfs -text
*.xm filter=lfs diff=lfs merge=lfs -text
*.mod filter=lfs diff=lfs merge=lfs -text
*.s3m filter=lfs diff=lfs merge=lfs -text

# Exhaustive machine-generated catalogs are kept for provenance/search but are
# too large for useful line-based Git diffs. Compact foundation catalogs stay
# ordinary reviewable JSON.
assets/runtime/goon/graphics/atlas.json filter=lfs diff=lfs merge=lfs -text
assets/runtime/goon/audio/audio.json filter=lfs diff=lfs merge=lfs -text

# The pinned upstream snapshot is byte-exact evidence. Do not normalize or
# reject its original whitespace.
assets/upstream/goon/** -whitespace
